          },
          "status": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "name": "adaptorch_list_runs"
    },
    {
      "annotations": {
        "destructiveHint": true,
        "idempotentHint": false,
        "openWorldHint": true,
        "readOnlyHint": false,
