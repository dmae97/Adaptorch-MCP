{
  "tools": [
    {
      "name": "adaptorch_audit",
      "description": "Queue an audit-only request; no patch, command execution or provider call in this tool.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "request_json": {
            "maxLength": 2097152,
            "minLength": 1,
            "title": "Request Json",
            "type": "string"
          },
          "idempotency_key": {
            "pattern": "^[A-Za-z0-9._:-]{8,128}$",
            "title": "Idempotency Key",
            "type": "string"
          }
        },
        "required": [
          "request_json",
          "idempotency_key"
        ],
        "title": "StartAuditArgs",
        "type": "object"
      },
      "outputSchema": {
        "$defs": {
          "LedgerEvent": {
            "additionalProperties": false,
            "properties": {
              "sequence": {
                "minimum": 1,
                "title": "Sequence",
                "type": "integer"
              },
              "code": {
                "enum": [
                  "audit_requested",
                  "audit_started",
                  "audit_retry_scheduled",
                  "audit_completed",
                  "audit_failed"
                ],
                "title": "Code",
                "type": "string"
              },
              "at": {
                "minimum": 0,
                "title": "At",
                "type": "number"
              }
            },
            "required": [
              "sequence",
              "code",
              "at"
            ],
            "title": "LedgerEvent",
            "type": "object"
          }
        },
        "additionalProperties": false,
        "properties": {
          "schema_version": {
            "const": "audit.status.v1",
            "default": "audit.status.v1",
            "title": "Schema Version",
            "type": "string"
          },
          "audit_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "title": "Audit Id",
            "type": "string"
          },
          "task_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "title": "Task Id",
            "type": "string"
          },
          "turn_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "title": "Turn Id",
            "type": "string"
          },
          "status": {
            "enum": [
              "QUEUED",
              "RUNNING",
              "COMPLETED",
              "FAILED"
            ],
            "title": "Status",
            "type": "string"
          },
          "request_sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Request Sha256",
            "type": "string"
          },
          "snapshot_sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Snapshot Sha256",
            "type": "string"
          },
          "is_current": {
            "title": "Is Current",
            "type": "boolean"
          },
          "validation_state": {
            "anyOf": [
              {
                "enum": [
                  "references_valid",
                  "incomplete",
                  "stale"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Validation State"
          },
          "error_code": {
            "anyOf": [
              {
                "enum": [
                  "audit_reviewer_timeout",
                  "audit_reviewer_failed",
                  "audit_output_invalid",
                  "audit_attempts_exhausted"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Code"
          },
          "created_at": {
            "minimum": 0,
            "title": "Created At",
            "type": "number"
          },
          "finished_at": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          },
          "events": {
            "items": {
              "$ref": "#/$defs/LedgerEvent"
            },
            "maxItems": 16,
            "title": "Events",
            "type": "array"
          },
          "is_correctness_proof": {
            "const": false,
            "default": false,
            "title": "Is Correctness Proof",
            "type": "boolean"
          }
        },
        "required": [
          "audit_id",
          "task_id",
          "turn_id",
          "status",
          "request_sha256",
          "snapshot_sha256",
          "is_current",
          "validation_state",
          "error_code",
          "created_at",
          "finished_at",
          "events"
        ],
        "title": "AuditSummary",
        "type": "object"
      },
      "annotations": {
        "title": "adaptorch_audit",
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      }
    },
