    {
      "name": "adaptorch_get_audit_artifact",
      "description": "Read one immutable audit artifact page, with a tenant-bound signed byte cursor.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "audit_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "title": "Audit Id",
            "type": "string"
          },
          "kind": {
            "enum": [
              "request",
              "candidates",
              "validation"
            ],
            "title": "Kind",
            "type": "string"
          },
          "page_bytes": {
            "default": 4096,
            "maximum": 16384,
            "minimum": 4,
            "title": "Page Bytes",
            "type": "integer"
          },
          "cursor": {
            "anyOf": [
              {
                "maxLength": 2048,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Cursor"
          }
        },
        "required": [
          "audit_id",
          "kind"
        ],
        "title": "GetAuditArtifactArgs",
        "type": "object"
      },
      "outputSchema": {
        "additionalProperties": false,
        "properties": {
          "schema_version": {
            "const": "audit.artifact-page.v1",
            "default": "audit.artifact-page.v1",
            "title": "Schema Version",
            "type": "string"
          },
          "audit_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "title": "Audit Id",
            "type": "string"
          },
          "kind": {
            "enum": [
              "request",
              "candidates",
              "validation"
            ],
            "title": "Kind",
            "type": "string"
          },
          "snapshot_sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Snapshot Sha256",
            "type": "string"
          },
          "artifact_sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Artifact Sha256",
            "type": "string"
          },
          "total_bytes": {
            "minimum": 0,
            "title": "Total Bytes",
            "type": "integer"
          },
          "offset_bytes": {
            "minimum": 0,
            "title": "Offset Bytes",
            "type": "integer"
          },
          "returned_bytes": {
            "maximum": 16384,
            "minimum": 0,
            "title": "Returned Bytes",
            "type": "integer"
          },
          "text": {
            "maxLength": 16384,
            "title": "Text",
            "type": "string"
          },
          "has_more": {
            "title": "Has More",
            "type": "boolean"
          },
          "next_cursor": {
            "anyOf": [
              {
                "maxLength": 2048,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          }
        },
        "required": [
          "audit_id",
          "kind",
          "snapshot_sha256",
          "artifact_sha256",
          "total_bytes",
          "offset_bytes",
          "returned_bytes",
          "text",
          "has_more",
          "next_cursor"
        ],
        "title": "ArtifactPage",
        "type": "object"
      },
      "annotations": {
        "title": "adaptorch_get_audit_artifact",
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    }
  ]
}
