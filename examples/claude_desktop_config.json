{
  "mcpServers": {
    "adaptorch": {
      "command": "adaptorch-mcp-client",
      "args": ["--base-url", "https://adaptorch.com"],
      "env": {
        "ADAPTORCH_CONTROL_PLANE_TOKEN": "<tenant-api-key>",
        "ADAPTORCH_MCP_PROVIDER": "<provider>",
        "ADAPTORCH_MCP_PROVIDER_MODEL": "<model>",
        "ADAPTORCH_MCP_PROVIDER_API_KEY": "<provider-key>"
      }
    }
  }
}
